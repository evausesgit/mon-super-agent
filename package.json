{
  "name": "mon-super-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @mon-super-agent/web run dev",
    "dev:api": "npm --workspace @mon-super-agent/api run dev",
    "build": "npm run build --workspaces",
    "typecheck": "npm run lint --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "vitest run --reporter=verbose",
    "start": "concurrently \"PORT=4000 npm --workspace @mon-super-agent/api run start\" \"npm --workspace @mon-super-agent/web run start\""
  },
  "dependencies": {
    "concurrently": "^9.0.0"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
